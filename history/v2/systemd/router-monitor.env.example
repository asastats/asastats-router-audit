# Copy to /etc/asastats/router-monitor.env and set restrictive permissions.
SECRET_KEY=replace-with-engine-secret
DATABASE_NAME=asastats
DATABASE_USER=asastats
DATABASE_PASSWORD=replace-with-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

ROUTER_MONITOR_ENABLED=true
ROUTER_MONITOR_NETWORK=mainnet
ROUTER_MONITOR_APP_ID=3671595889
ROUTER_MONITOR_ACCOUNT_ADDRESS=replace-with-application-account
ROUTER_MONITOR_POLL_INTERVAL_SECONDS=60
ROUTER_MONITOR_FEE_BPS=10
ROUTER_MONITOR_BATCH_CEILING=replace-with-accrued-ceiling
ROUTER_MONITOR_PROVIDERS=tinyman2,pact,stamm,algofi

ROUTER_MONITOR_ALGOD_ADDRESS=https://replace-with-private-algod
ROUTER_MONITOR_ALGOD_TOKEN=replace-with-algod-token
ROUTER_MONITOR_INDEXER_ADDRESS=https://replace-with-private-indexer
ROUTER_MONITOR_INDEXER_TOKEN=replace-with-indexer-token

ROUTER_MONITOR_WEBHOOK_URL=https://replace-with-alert-receiver
ROUTER_MONITOR_WEBHOOK_SECRET=replace-with-webhook-hmac-secret
ROUTER_MONITOR_WEBHOOK_TIMEOUT_SECONDS=10
